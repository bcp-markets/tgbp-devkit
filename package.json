{
  "name": "@tgbp/kit",
  "version": "0.1.0",
  "description": "tGBP, the tokenised British pound, for developers: token registry, on-chain balances, transfers and watchers on EVM chains and Solana, a typed client for the mint, redeem and swap API, and an MCP server and agent skills with a client-side spend policy.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcp-markets/tgbp-devkit.git"
  },
  "homepage": "https://github.com/bcp-markets/tgbp-devkit#readme",
  "bugs": "https://github.com/bcp-markets/tgbp-devkit/issues",
  "keywords": [
    "tgbp",
    "stablecoin",
    "gbp",
    "erc20",
    "solana",
    "viem",
    "mcp",
    "agent",
    "x402"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.6",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./evm": {
      "types": "./dist/evm/index.d.ts",
      "import": "./dist/evm/index.js"
    },
    "./solana": {
      "types": "./dist/solana/index.d.ts",
      "import": "./dist/solana/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./x402/server": {
      "types": "./dist/x402/server.d.ts",
      "import": "./dist/x402/server.js"
    },
    "./x402/client": {
      "types": "./dist/x402/client.d.ts",
      "import": "./dist/x402/client.js"
    }
  },
  "bin": {
    "tgbp-mcp": "./dist/mcp/cli.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "generate:registry": "tsx scripts/generate-registry.ts",
    "generate:api": "tsx scripts/generate-api.ts",
    "check:disclosure": "tsx scripts/disclosure.ts",
    "build:fixtures": "forge build --root test/fixtures --contracts . --out out --cache-path cache && tsx scripts/export-fixture.ts",
    "prepublishOnly": "pnpm run build",
    "x402:demo": "tsx examples/x402-demo/demo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "express": "^5.3.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.57.7",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.5.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "viem": "^2.57.7",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@solana-program/token": {
      "optional": true
    },
    "@solana/kit": {
      "optional": true
    },
    "@x402/core": {
      "optional": true
    },
    "@x402/evm": {
      "optional": true
    },
    "@x402/express": {
      "optional": true
    },
    "@x402/extensions": {
      "optional": true
    },
    "viem": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
