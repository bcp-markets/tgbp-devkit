{
  "$schema": "https://unpkg.com/wrangler@4.119.0/config-schema.json",
  "name": "tgbp-x402-facilitator",
  "compatibility_date": "2026-08-07",
  "main": "worker/index.ts",
  // Serves on the account's workers.dev URL; go-live.sh reads it from the deploy.
  "workers_dev": true,
  "preview_urls": false,
  // One instance signs every settlement in turn and keeps the pending-settlement store.
  "durable_objects": {
    "bindings": [{ "name": "FACILITATOR", "class_name": "TgbpFacilitator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TgbpFacilitator"] }],
  "vars": {
    "FACILITATOR_CHAIN": "base",
    "MIN_GAS_ETH": "0.001"
  },
  // Secrets, set with `wrangler secret put <NAME> --cwd facilitator`:
  //   FACILITATOR_PRIVATE_KEY  the gas-only key; it holds ETH for gas, never tGBP
  //   FACILITATOR_RPC_URL      a private RPC endpoint for FACILITATOR_CHAIN
  //   FACILITATOR_AUTH_TOKEN   the bearer token resource servers send to /verify and /settle
  //   ALERT_WEBHOOK_URL        receives the low-gas alert as {"text": "…"}
  // Checks the gas key's ETH balance against MIN_GAS_ETH.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Keeps the settlement and low-gas logs.
  "observability": { "enabled": true }
}
