  },
  "components": {
    "parameters": {
      "FromDate": {
        "name": "from",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "IdempotencyKeyOptional": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "ToDate": {
        "name": "to",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "responses": {
      "ApprovalGated": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "object",
                  "properties": {
                    "approval_request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "AttributionRequired": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "BadRequest": {
        "headers": {
          "X-Rate-Limit-Limit": {
            "schema": {
              "type": "integer"
            }
          },
          "X-Rate-Limit-Remaining": {
            "schema": {
              "type": "integer"
            }
          },
          "X-Rate-Limit-Reset": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "headers": {
          "X-Rate-Limit-Limit": {
            "schema": {
              "type": "integer"
            }
          },
          "X-Rate-Limit-Remaining": {
            "schema": {
              "type": "integer"
            }
          },
          "X-Rate-Limit-Reset": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "headers": {
          "X-Rate-Limit-Limit": {
            "schema": {
              "type": "integer"
            }
          },
          "X-Rate-Limit-Remaining": {
            "schema": {
              "type": "integer"
            }
          },
          "X-Rate-Limit-Reset": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "TooManyRequests": {
        "headers": {
          "X-Rate-Limit-Limit": {
            "schema": {
              "type": "integer"
            }
          },
          "X-Rate-Limit-Remaining": {
            "schema": {
              "type": "integer"
            }
          },
          "X-Rate-Limit-Reset": {
            "schema": {
              "type": "integer"
            }
          },
          "X-Rate-Limit-Retry-After": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RateLimitErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "headers": {
          "X-Rate-Limit-Limit": {
            "schema": {
              "type": "integer"
            }
          },
          "X-Rate-Limit-Remaining": {
            "schema": {
              "type": "integer"
            }
          },
          "X-Rate-Limit-Reset": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "Amount": {
        "type": "object",
        "required": [
          "currency",
          "value"
        ],
        "properties": {
          "currency": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "minimum": 5,
            "multipleOf": 0.01
          }
        }
      },
      "BurnConfirmationRequest": {
        "type": "object",
        "properties": {
          "txHash": {
            "type": "string"
          }
        }
      },
      "BurnConfirmationResponse": {
        "type": "object",
        "required": [
          "message",
          "data"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "redemptionId",
              "burnTxHash",
              "status",
              "bankProviderCode"
            ],
            "properties": {
              "redemptionId": {
                "type": "string"
              },
              "burnTxHash": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "payout_initiated",
                  "payout_skipped",
                  "payout_withheld"
                ]
              },
              "message": {
                "type": "string"
              },
              "bankProviderCode": {
                "type": "string"
              }
            }
          }
        }
      },
      "CancelRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "ChainId": {
        "type": "string"
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "properties": {
                  "field_errors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "field",
                        "code",
                        "message"
                      ],
                      "properties": {
                        "field": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    }
                  },
                  "constraint_violations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "constraint",
                        "message"
                      ],
                      "properties": {
                        "constraint": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "expected": {
                          "type": "string"
                        },
                        "actual": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    }
                  },
                  "request_id": {
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "path": {
                    "type": "string"
                  },
                  "method": {
                    "type": "string"
                  },
                  "user_id": {
                    "type": "string",
                    "nullable": true
                  },
                  "retry_after": {
                    "type": "integer",
                    "nullable": true
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "documentation_url": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true
                  }
                },
                "additionalProperties": true
              }
            }
          }
        }
      },
      "Mint": {
        "type": "object",
        "required": [
          "id",
          "customerId",
          "chain",
          "address",
          "tx_hash",
          "amount",
          "status",
          "credited_at",
          "created_at",
          "updated_at",
          "paymentType",
          "relationshipToCustomer",
          "nameOfPayer",
          "bank_transfer_details"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "sourceBankAccountId": {
            "type": "string",
            "nullable": true
          },
          "chain": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "tx_hash": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "in_transit",
              "confirmed",
              "failed",
              "cancelled",
              "pending_compliance_review"
            ]
          },
          "cancelled_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cancelled_reason": {
            "type": "string",
            "nullable": true
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "credited_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
